# Copie este archivo a .env y complete los valores. .env NO se versiona.
# Aqui solo van marcadores de posicion: nunca pegue claves reales en este archivo.
NODE_ENV=development
PORT=3000
# Demo del equipo: base alojada en Supabase (use la cadena "Session pooler" si la directa falla).
DATABASE_URL=postgresql://postgres:<CLAVE_DE_LA_BASE>@db.<REF_DEL_PROYECTO>.supabase.co:5432/postgres
DATABASE_SSL=true
# Base local SOLO para pruebas (npm run db:test:up). Las pruebas la vacian.
TEST_DATABASE_URL=postgresql://nexo:test@localhost:54329/nexo_test
# Clave ficticia de las 8 cuentas de demostracion (no use una clave real).
DEMO_PASSWORD=Demo-Nexo-2030
AI_PROVIDER=replay
AI_TIMEOUT_MS=5000
SESSION_HOURS=8
LOG_LEVEL=info
